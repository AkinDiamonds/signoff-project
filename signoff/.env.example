# --- PayPal (sandbox only) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Buyer-side sandbox identity used only by the test-dispute generator
PAYPAL_BUYER_PAYER_ID=

# --- Database ---
DATABASE_URL=postgresql+psycopg://signoff:signoff@localhost:5432/signoff

# --- LLM ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_DAILY_BUDGET_USD=3
USE_SCENARIO_CACHE=true

# --- App ---
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173
APPROVAL_TOKEN_SECRET=
DEMO_FROZEN=false

# --- Web (build-time; visible in the browser bundle by design) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_AG_STUDIO_LICENSE_KEY=

# --- PayPal (sandbox only) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
# Buyer-side sandbox identity used only by the test-dispute generator
PAYPAL_BUYER_PAYER_ID=

# --- Database ---
DATABASE_URL=postgresql+psycopg://signoff:signoff@localhost:5432/signoff

# --- LLM ---
# Provider behind a thin interface (CONVENTIONS §8). Set to 'glimmer' for internal hosted model
# or 'openai' for OpenAI-compatible fallback. See ADR-016 in docs/decisions.md.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_DAILY_BUDGET_USD=3
USE_SCENARIO_CACHE=true

# --- App ---
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173
APPROVAL_TOKEN_SECRET=
# Global demo kill switch: true makes scenario creation return 503.
DEMO_FROZEN=false
# Demo hold mode: holds incoming PayPal disputes in pool until claimed by judge
DEMO_HOLD_DISPUTES=false
DEMO_POOL_HOLD=false
DEMO_CLAIM_TOKEN=
DEMO_SHOW_APPROVAL_LINKS=false
STORE_API_KEY=
# Web build-time value; must match DEMO_CLAIM_TOKEN for the pool page to claim disputes.
VITE_DEMO_CLAIM_TOKEN=demo-token-active
# Demo scenario generator: pool size and daily quotas.
DEMO_POOL_SIZE_PER_SCENARIO=3
DEMO_SCENARIOS_PER_SESSION_PER_DAY=30
DEMO_SCENARIOS_PER_IP_PER_DAY=60
DEMO_SESSION_TTL_HOURS=24

# --- Web (build-time; visible in the browser bundle by design) ---
# VITE_AG_STUDIO_LICENSE_KEY is NOT required. AG Grid confirmed hackathon use without licence (ADR-015).
VITE_API_BASE_URL=http://localhost:8000

# --- Shop (build-time; visible in the browser bundle by design) ---
VITE_PAYPAL_CLIENT_ID=sb


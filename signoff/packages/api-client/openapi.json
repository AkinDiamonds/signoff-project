    "/api/charter": {
      "get": {
        "description": "Retrieves active charter, seeds default v1 if uninitialized, or returns a specific version.",
        "operationId": "get_charter_api_charter_get",
        "parameters": [
          {
            "description": "Specific charter version to retrieve",
            "in": "query",
            "name": "version",
            "required": false,
            "schema": {
              "anyOf": [

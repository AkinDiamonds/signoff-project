{
  "components": {
    "schemas": {
      "ActionType": {
        "description": "Proposed action type for PayPal disputes.",
        "enum": [
          "PROVIDE_EVIDENCE",
          "SEND_MESSAGE",
          "MAKE_OFFER",
          "ACCEPT_CLAIM",
          "ESCALATE",
          "APPEAL"
        ],
        "title": "ActionType",
        "type": "string"
      },
      "CharterResponse": {
        "additionalProperties": false,
        "description": "Full versioned charter response shape.",
        "properties": {
          "auto_accept_max": {
            "$ref": "#/components/schemas/MoneyLimit-Output"
          },
          "auto_act_max_dispute_amount": {
            "$ref": "#/components/schemas/MoneyLimit-Output"
          },
          "auto_offer_max": {
            "$ref": "#/components/schemas/MoneyLimit-Output"
          },
          "auto_provide_evidence": {
            "default": true,
            "title": "Auto Provide Evidence",
            "type": "boolean"
          },
          "auto_send_message": {
            "default": true,
            "title": "Auto Send Message",
            "type": "boolean"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "never_auto_actions": {
            "items": {
              "$ref": "#/components/schemas/ActionType"
            },
            "title": "Never Auto Actions",
            "type": "array"
          },
          "never_auto_reasons": {
            "items": {
              "$ref": "#/components/schemas/DisputeReason"
            },
            "title": "Never Auto Reasons",
            "type": "array"
          },
          "repeat_disputer_threshold": {
            "default": 2,
            "minimum": 0.0,
            "title": "Repeat Disputer Threshold",
            "type": "integer"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "auto_offer_max",
          "auto_accept_max",
          "auto_act_max_dispute_amount",
          "version",
          "created_at"
        ],
        "title": "CharterResponse",
        "type": "object"
      },
      "DisputeReason": {
        "description": "PayPal dispute reason categories.",
        "enum": [
          "MERCHANDISE_OR_SERVICE_NOT_RECEIVED",
          "MERCHANDISE_OR_SERVICE_NOT_AS_DESCRIBED",
          "UNAUTHORISED",
          "CREDIT_NOT_PROCESSED",
          "DUPLICATE_TRANSACTION",
          "INCORRECT_AMOUNT",
          "PAYMENT_BY_OTHER_MEANS",
          "CANCELED_RECURRING_BILLING",
          "PROBLEM_WITH_REMITTANCE",
          "OTHER"
        ],
        "title": "DisputeReason",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Fields",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "MoneyLimit-Input": {
        "additionalProperties": false,
        "description": "Monetary limit enforcing fixed-precision Decimal and merchant currency.",
        "properties": {
          "currency_code": {
            "title": "Currency Code",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "currency_code",
          "value"
        ],
        "title": "MoneyLimit",
        "type": "object"
      },
      "MoneyLimit-Output": {
        "additionalProperties": false,
        "description": "Monetary limit enforcing fixed-precision Decimal and merchant currency.",
        "properties": {
          "currency_code": {
            "title": "Currency Code",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "currency_code",
          "value"
        ],
        "title": "MoneyLimit",
        "type": "object"
      },
      "UpdateCharterRequest": {
        "additionalProperties": false,
        "description": "Charter update request requiring the base version for optimistic concurrency.",
        "properties": {
          "auto_accept_max": {
            "$ref": "#/components/schemas/MoneyLimit-Input"
          },
          "auto_act_max_dispute_amount": {
            "$ref": "#/components/schemas/MoneyLimit-Input"
          },
          "auto_offer_max": {
            "$ref": "#/components/schemas/MoneyLimit-Input"
          },
          "auto_provide_evidence": {
            "default": true,
            "title": "Auto Provide Evidence",
            "type": "boolean"
          },
          "auto_send_message": {
            "default": true,
            "title": "Auto Send Message",
            "type": "boolean"
          },
          "base_version": {
            "description": "The charter version this update is based on",
            "title": "Base Version",
            "type": "integer"
          },
          "never_auto_actions": {
            "items": {
              "$ref": "#/components/schemas/ActionType"
            },
            "title": "Never Auto Actions",
            "type": "array"
          },
          "never_auto_reasons": {
            "items": {
              "$ref": "#/components/schemas/DisputeReason"
            },
            "title": "Never Auto Reasons",
            "type": "array"
          },
          "repeat_disputer_threshold": {
            "default": 2,
            "minimum": 0.0,
            "title": "Repeat Disputer Threshold",
            "type": "integer"
          }
        },
        "required": [
          "auto_offer_max",
          "auto_accept_max",
          "auto_act_max_dispute_amount",
          "base_version"
        ],
        "title": "UpdateCharterRequest",
        "type": "object"
      }
    }
  },
  "info": {

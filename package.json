{
  "name": "signoff-project",
  "private": true,
  "type": "module",
  "workspaces": [
    "signoff/packages/*",
    "signoff/web",
    "signoff/shop"
  ],
  "scripts": {
    "generate": "npm run --workspace=@signoff/api-client generate",
    "check:client": "node scripts/check-client-fresh.mjs",
    "check:enums": "python signoff/scripts/check_enum_parity.py",
    "test:types": "vitest run --typecheck.enabled && npm run check:enums",
    "test:web": "vitest run --project web --project shop --project ui --project api-client",
    "test": "vitest run",
    "build": "npm run --workspace=@signoff/web build && npm run --workspace=@signoff/shop build",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
